#!/bin/sh -e

PREFIX=transient_standard
NAME=input_transient_preMPTgl
SRC=$HOME/zemba/work/${PREFIX}/${NAME}
SRD=$HOME/zemba/model

RUNDIR=/cluster/work/users/$USER/${PREFIX}/${NAME}
SCRATCH=/cluster/work/jobs/$SLURM_JOB_ID

mkdir -p $RUNDIR
cd $RUNDIR

rm -f zemba.py
rm -f utilities.py
rm -f initialize_zemba.py
rm -f solar_forcing.py
rm -f laskar_2006.txt
rm -rf other_data/
rm -f CO2.txt
rm -f ice_fraction.txt
rm -f pi_land_albedo.txt
rm -f pi_ocean_albedo.txt
rm -f si_fraction.txt
rm -f si_temperature.txt
rm -f sc_fraction.txt

cp ${SRD}/zemba.py zemba.py
cp ${SRD}/utilities.py utilities.py
cp ${SRD}/initialize_zemba.py initialize_zemba.py
cp ${SRD}/solar_forcing.py solar_forcing.py
cp ${SRD}/laskar_2006.txt laskar_2006.txt
cp -r ${SRD}/other_data other_data
cp ${SRD}/CO2.txt CO2.txt
cp ${SRD}/ice_fraction.txt ice_fraction.txt
cp ${SRD}/pi_land_albedo.txt pi_land_albedo.txt
cp ${SRD}/pi_ocean_albedo.txt pi_ocean_albedo.txt
cp ${SRD}/si_fraction.txt si_fraction.txt
cp ${SRD}/si_temperature.txt si_temperature.txt
cp ${SRD}/sc_fraction.txt sc_fraction.txt

cp ${SRC}/transient_standard.run transient_standard.run
cp ${SRC}/transient_run.py transient_run.py
cp ${SRC}/input_transient_preMPTgl.py input_transient_preMPTgl.py
sbatch transient_standard.run
